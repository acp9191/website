{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint's `correctness` category is on by default and covers most of what
  // the old ESLint config enabled, including the React Compiler rules
  // (static-components, set-state-in-effect, purity). `npm run lint` passes
  // --deny-warnings, so warn vs error makes no difference; everything below
  // is "error" only for readability.
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y"],
  "ignorePatterns": ["public/sw.js", "public/workbox-*.js"],
  "rules": {
    // Leading underscore marks a binding as deliberately unused.
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],

    // The filter dropdowns are a custom ARIA combobox/listbox on purpose
    // (styling a native <select> is not possible); useListbox supplies the
    // keyboard and focus behaviour and a11y.spec.ts tests it.
    "jsx-a11y/prefer-tag-over-role": "off",

    // Outside `correctness`, but the old ESLint config ran them.
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-array-constructor": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error"
  }
}
