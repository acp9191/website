{
  "name": "avery-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-sw.mjs",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@serwist/next": "^9.5.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.6",
    "next-intl": "^4.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false
  }
}
